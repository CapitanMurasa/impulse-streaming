@startuml
title Database schema

entity "Tracks_Playlists" as tp{
    * id: int <<PK>>
    --
    * playlist_id: int <<FK>>
    * track_id: int <<FK>>
}

entity "Users" as user{
 * id: int <<PK>>
 * role: text
 * username: text <<UNIQUE>>
   display_name: text
 * password_hash: text

}

entity "Albums" as albums{
    * id: int <<PK>>
    * name: text
    description: text
    --
    * artist_id: int <<FK>>
}

entity "Tracks" as track{
    * id: int <<PK>>
    * public_id: uuid <<UNIQUE>>
    * name: text
    * status: enum
    * storage_key: text <<UNIQUE>>
    * public: bool
    sha256: char(64)
    size_bytes: int
    duration_s: int
    bitrate_bps: int
    --
    * format_id: int <<FK>>
    * User_id: int <<FK>>
    Genre_id: int <<FK>>
    Artist_id: int <<FK>>
    Album_id: int <<FK>>

}

entity "Playlists" as playlists{
    * id: int <<PK>>
    * name: text
    * public: bool
    --
    * user_id: int <<FK>>

}

entity "Artists" as artist{
    * id: int <<PK>>
    * name: text
}

entity "Genre" as genre{
    * id: int <<PK>>
    * name: text
}

entity "Formats" as format{
    * id: int <<PK>>
    * name: text <<UNIQUE>>
    * extension: text
}


entity "Track Upload job" as job{
    * id: int <<PK>>
    upload_created: timestamptz
    upload_begin: timestamptz
    upload_end: timestamptz
    error: text
    attempts: int
    --
    * track_id: int <<FK>>
}

tp }o--|| track
tp }o--|| playlists
job }o--|| track
track }o--|| format
track }o--o| albums
track }o--o| artist
track }o--|| user
track }o--o| genre
artist }o--|| albums
playlists }o--|| user


@enduml